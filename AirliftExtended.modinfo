<?xml version="1.0" encoding="utf-8"?>
<Mod id="b8ea0ca1-9f54-4e24-ba8e-cc8220c8d2fc" version="1.1">
	<!--
	  * @file AirliftExtended.modinfo
	  * @brief Mod configuration manifest managing asset loading, game database additions, and text injection actions.
	  * @author Legandy
	  -->
	<Properties>
		<Name>LOC_LGY_AIRLIFT_EXTENDED_MOD_NAME</Name>
		<Teaser>LOC_LGY_AIRLIFT_EXTENDED_MOD_TEASER</Teaser>
		<Description>LOC_LGY_AIRLIFT_EXTENDED_DESCRIPTION</Description>
		<Authors>Legandy</Authors>
		<AffectsSavedGames>1</AffectsSavedGames>
		<CompatibleVersions>1.2,2.0</CompatibleVersions>
	</Properties>

	<LocalizedText>
		<Text id="LOC_LGY_AIRLIFT_EXTENDED_MOD_NAME">
			<en_US>Airlift Extended</en_US>
			<de_DE>Lufttransport Erweitert</de_DE>
		</Text>
		<Text id="LOC_LGY_AIRLIFT_EXTENDED_MOD_TEASER">
			<en_US>Airlifts to Airstrips are now possible.</en_US>
			<de_DE>Lufttransport zu Landepisten ist jetzt möglich.</de_DE>
		</Text>
		<Text id="LOC_LGY_AIRLIFT_EXTENDED_DESCRIPTION">
			<en_US>Real Rapid Deployment is now possible.[NEWLINE]Units can now be airlifted directly to an Airstrip or its adjacent plots.[NEWLINE][NEWLINE]REQUIREMENTS:[NEWLINE]• Aerodrome with an Airport[NEWLINE]• Rapid Deployment Civic[NEWLINE][NEWLINE]COST:[NEWLINE]• 10 Oil per airlifted Military/Support/Religious/Hero/Military Great People unit[NEWLINE]• Free for Settlers/Builders/Civilian Great People[NEWLINE][NEWLINE]PENALTY:[NEWLINE]• Each missing Oil inflicts +5 Damage upon landing (Max 50)[NEWLINE]• If no health is left, the unit can be killed in a crash landing</en_US>
			<de_DE>Ein echter Schneller Einsatz ist jetzt möglich. Einheiten können nun direkt zu einem Flugplatz oder den angrenzenden Feldern transportiert werden.[NEWLINE][NEWLINE]VORAUSSETZUNGEN:[NEWLINE]• Flugplatz mit einem Flughafen[NEWLINE]• Die Ausrichtung Schneller Einsatz[NEWLINE][NEWLINE]KOSTEN:[NEWLINE]• 10 Öl pro transportierter Militär/Unterstützung/Religiöser/Militär Große Persönlichkeiten Einheit[NEWLINE]• Kostenlos für Siedler/Baumeister/Zivile Große Persönlichkeiten[NEWLINE][NEWLINE]STRAFE:[NEWLINE]• Jede fehlende Öleinheit verursacht bei der Landung +5 Schaden (Max 50)[NEWLINE]• Bei zu geringer Gesundheit kann die Einheit bei einer Bruchlandung ums Leben kommen</de_DE>
		</Text>
	</LocalizedText>
	
	<InGameActions>
		<!-- Core Gameplay Definitions -->
		<UpdateDatabase id="Database">
			<File>Core/AirliftExtended.sql</File>
		</UpdateDatabase>
		
		<!-- Split Language Text Files -->
		<UpdateText id="Text">
			<File>Text/AirliftExtended_en_US.sql</File>
			<File>Text/AirliftExtended_de_DE.sql</File>
		</UpdateText>
		
		<!-- Front-Facing Graphic Icons -->
		<UpdateIcons id="Icons">
			<File>Icons/AirliftExtended_Icons.xml</File>
		</UpdateIcons>

		<!-- Engine Logic Scripts -->
		<AddGameplayScripts id="GameplayScripts">
			<File>Scripts/AirliftExtended_Gameplay.lua</File>
		</AddGameplayScripts>
	</InGameActions>
	
	<Files>
		<File>Core/AirliftExtended.sql</File>
		<File>Scripts/AirliftExtended_Gameplay.lua</File>
		<File>Icons/AirliftExtended_Icons.xml</File>
		<File>Text/AirliftExtended_en_US.sql</File>
		<File>Text/AirliftExtended_de_DE.sql</File>
	</Files>
</Mod>